// ==========================================
// 1. 報價與銷售階段 (滿足功能一)
// ==========================================

model Quotation {
  id            String   @id @default(cuid())
   // ★ 新增：報價單編號（例如 Q-2026-0001）
  number        String?  @unique
  title         String   // 例如：某某公司網站建置案
  status        QuoteStatus @default(NEGOTIATING)

  // ★ 新增：有效期限
  validUntil    DateTime?
    // ★ 新增：備註
  note          String?  @db.Text
  // 關聯人員
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  
  salesId       String
  sales         User     @relation("SalesQuotations", fields: [salesId], references: [id])

  // 金錢欄位 (底層全存，靠 tRPC 卡控可見度)
  baseCost      Decimal? // Admin 評估的底線成本 (5元)
  agreedCost    Decimal? // Admin 與 Sales 談好的內部價 (10元)
  customerPrice Decimal? // Sales 報給客人的最終價 (20元)
  pmBudget      Decimal? // 專案成立後，給 PM 執行的資金/預算

  // 成功後轉成的專案 (1對1)
  projectId     String?  @unique
  project       Project? @relation(fields: [projectId], references: [id])

  versions        QuotationVersion[]  // 版本歷史
  currentVersionId String?             // 當前顯示的版本ID

  // 雙通道對話紀錄
  // 👇 這裡變成「兩個對話 data」 👇
  internalMessages InternalQuoteMessage[] // 只有 Admin/Sales 可以讀寫
  externalMessages ExternalQuoteMessage[] // Sales/Customer 可以讀寫

  QuoteMessage QuoteMessage[]

  companyProfileId String?
  companyProfile   CompanyProfile? @relation(fields: [companyProfileId], references: [id])
  
  totalAmount   Decimal  @default(0) // ★ 報價單下方結算總價

    // 關聯到報價明細列表
  items         QuotationItem[]
  Invoice       Invoice[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum QuoteStatus {
  DRAFT
  NEGOTIATING // 交涉中
  WON         // 贏單 (可轉專案)
  LOST        // 輸單
  CANCELLED
  CONVERTED   // ← 加上這行
}

enum InvoiceType {
  STANDARD   // 一般收據
  TAIL       // 尾款收據
}

// 報價對話紀錄 (滿足功能一的雙通道對話)
model QuoteMessage {
  id          String   @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  
  senderId    String   // 發送者 ID (可能是 User ID 也可能是 Customer ID)
  content     String   // 對話內容
  
  // 關鍵：用這個來區分是內部對話還是外部對話
  visibility  MessageVisibility 

  createdAt   DateTime @default(now())
}

enum MessageVisibility {
  INTERNAL // Admin 與 Sales 的私下溝通 (客戶絕對看不到)
  EXTERNAL // Sales 與 客戶 的溝通 (Admin也能看，但這是對外的)
}



// 數據 1：內部對話 (只有 Admin 跟 Sales 看得到)
model InternalQuoteMessage {
  id          String    @id @default(cuid())
  content     String
  
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  
  // 發送者「必定」是內部員工 (Admin 或 Sales)
  senderId    String
  sender      User      @relation(fields: [senderId], references: [id])
  
  createdAt   DateTime  @default(now())
}

// 數據 2：外部對話 (Sales 跟 客戶 的對話)
model ExternalQuoteMessage {
  id               String    @id @default(cuid())
  content          String
  
  quotationId      String
  quotation        Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  
  // 發送者可能是「內部員工(Sales)」，也可能是「外部客戶(Customer)」
  senderUserId     String?
  senderUser       User?     @relation(fields: [senderUserId], references: [id])
  
  senderCustomerId String?
  senderCustomer   Customer? @relation(fields: [senderCustomerId], references: [id])
  
  createdAt        DateTime  @default(now())
}



// 銷售與客戶的獨立對話記錄
model SalesCustomerConversation {
  id          String   @id @default(cuid())
  content     String   // 對話內容
  createdAt   DateTime @default(now())
  
// 這裡加上發送者類型，用來辨識是客戶還是業務發的 (例如 "CUSTOMER" 或 "SALES")
  senderType  SenderType   @default(CUSTOMER) 

  // 關聯
  salesId     String
  sales       User     @relation(fields: [salesId], references: [id])
  
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  
  // 是否已讀 (可選)
  isRead      Boolean  @default(false)
  
  @@index([salesId, customerId])
  @@map("sales_customer_conversations")
}

// 新增合作申請表模型
model CollaborationRequest {
  id              String   @id @default(cuid())
  customer        Customer @relation(fields: [customerId], references: [id])
  customerId      String
  
  companyName     String
  contactPhone    String
  requirements    String   @db.Text // 客戶詳細需求
  
  // 最重要的：參考作品 (留空或指定)
  referenceProjectId String?
  referenceProject   Project? @relation("ReferenceProject", fields: [referenceProjectId], references: [id])
  
  status          String   @default("PENDING") // PENDING, PROCESSING, REJECTED, QUOTED
  createdAt       DateTime @default(now())
}

// 1. 預設的公司抬頭與 Logo 模組 (可供多公司/多品牌報價使用)
model CompanyProfile {
  id          String      @id @default(cuid())
  name        String      @unique // 例如："A科技股份有限公司", "B設計工作室"
  logoUrl     String?     // 公司 Logo 圖片網址
  address     String?
  phone       String?
  taxId       String?     // 統編
  
  quotations  Quotation[] // 關聯到報價單
  Invoice     Invoice[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
// 2. Admin 預先定義的服務項目 (可重複使用的商品/服務)
model Service {
  id          String      @id @default(cuid())
  name        String      // 例如："進階 UI/UX 設計", "年度主機維護"
  description String?
  basePrice   Decimal     @default(0) // 預設參考價格
  type        String      // 服務類型 (例如："DESIGN", "DEVELOPMENT", "MAINTENANCE")
  price       Decimal     @default(0) // 預設參考價錢
  isActive    Boolean     @default(true)
  
  // 紀錄這項服務被用在哪些報價項目中
  quoteItems  QuotationItem[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
// 3. 報價單內的「收費明細列表」(Line Items)
model QuotationItem {
  id          String      @id @default(cuid())
  quotationId String
  quotation   Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  
  serviceId   String?
  service     Service?     @relation(fields: [serviceId], references: [id])
  
  customName  String?     // 允許業務針對此單修改服務名稱
  quantity    Int         @default(1) // 數量
  unitPrice   Decimal     // 實際報價單價
  subtotal    Decimal     // 小計 (quantity * unitPrice)
  @@index([quotationId])
}
// 實際使用時間明細表（解決「什麼時候會用」的多筆記錄需求）
model EquipmentUsageSchedule {
  id               String      @id @default(cuid())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // 關聯到哪一次借用記錄
  equipmentLogId   String
  equipmentLog     EquipmentLog @relation(fields: [equipmentLogId], references: [id], onDelete: Cascade)

  // 實際預計使用的開始與結束時間（精準到分鐘）
  usageStart       DateTime    // 例如：2026-04-17 12:00:00（第2天中午）
  usageEnd         DateTime?   // 可選，如果只有開始時間可不填結束

  // 額外說明（選填）
  note             String?     // 例如："用於外拍空鏡頭" 或 "只用下午時段"

  @@index([equipmentLogId])
  @@index([usageStart])   // 方便按時間範圍查詢
}

// 報價單版本紀錄
model QuotationVersion {
  id              String    @id @default(cuid())
  versionNumber   Int       
  title           String    
  status          QuoteStatus @default(NEGOTIATING)
  baseCost        Decimal?  
  agreedCost      Decimal?  
  customerPrice   Decimal?  
  pmBudget        Decimal?  
  totalAmount     Decimal   @default(0)
  notes           String?   
  isLatest        Boolean   @default(false)
  changeLog       String?   // 記錄這次改版修改了什麼
  
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  
  // 版本快照（JSON 格式儲存完整內容）
  snapshot        Json      // 儲存完整的報價單內容
  
  createdAt       DateTime  @default(now())
  createdBy       String?   // 誰建立的版本

  @@unique([quotationId, versionNumber])
  @@index([quotationId, isLatest])
}


model VersionMessage {
  id          String   @id @default(cuid())
  versionId   String
  version     WorkVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  content     String
  senderType  String   // 'customer', 'sales', 'admin'
  senderId    String   // 可以是 User.id 或 Customer.id
  
  // 直接關聯到 User（當 senderType 不是 customer 時）
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  
  // 直接關聯到 Customer（當 senderType 是 customer 時）
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([versionId])
  @@index([createdAt])
  @@index([userId])
  @@index([customerId])
}

// ===== 1. ProjectMessage Model (全新) =====
model ProjectMessage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   String
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId])
  @@index([createdAt])
}


// ==========================================
// Admin 自定義 Dashboard 系統
// ==========================================
// ① Admin 的儀表板配置（一個 Admin 可以有多個儀表板頁籤）
model AdminDashboard {
  id        String   @id @default(cuid())
  name      String   @default("我的管理儀表板")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 版面配置 (Grid layout JSON)
  // 例如: { "columns": 4, "gap": 4 }
  layout    Json     @default("{\"columns\":4}")
  
  // 這個儀表板包含哪些 Widget
  widgets   DashboardWidget[]
  
  isDefault Boolean  @default(false) // 是否為預設儀表板
  order     Int      @default(0)     // 排序
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, name])
  @@index([userId])
}
// ② 儀表板上的每個小元件
model DashboardWidget {
  id           String   @id @default(cuid())
  dashboardId  String
  dashboard    AdminDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  
  // 指向哪個預定義的 Metric
  metricKey    String   // 例如: "total_users", "active_projects"
  layout      Json
  
  // 自訂設定
  customTitle  String?  // 自訂顯示名稱（留空則用 Metric 預設名稱）
  position     Int      @default(0) // 排序位置
  width        Int      @default(1) // 佔幾欄 (1-4)
  height       Int      @default(1) // 高度單位
  
  // 篩選條件 (JSON)
  // 例如: { "status": "IN_PROGRESS", "dateRange": "THIS_MONTH" }
  filterConfig Json?
  
  // 圖表設定
  // 例如: { "chartType": "BAR", "showLegend": true }
  chartConfig  Json?
  
  isVisible    Boolean  @default(true) // 是否隱藏（不用刪除）
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([dashboardId])
}


// ★ 新增：Admin-Sales 專案內部對話頻道
// 一個專案只有一條，自動在專案建立+指派Sales時創建
model ProjectSalesChannel {
  id        String   @id @default(cuid())
  projectId String   @unique  // 一個 Project 只有一個頻道
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // 頻道內的訊息
  messages  ProjectSalesMessage[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ★ 新增：Admin-Sales 專案內部對話訊息
// 只有 Admin 與該專案的 Sales 可以讀寫
model ProjectSalesMessage {
  id        String   @id @default(cuid())
  channelId String
  channel   ProjectSalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  content   String
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  
  // 已讀狀態（選配，方便追蹤）
  readAt    DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([channelId])
  @@index([channelId, createdAt])
}

// ==========================================
// 收據系統（Admin 數錢用）
// ==========================================
// 收據狀態
enum InvoiceStatus {
  UNPAID    // 未付款
  PARTIAL   // 部分付款（已收訂金/期中款）
  PAID      // 已全額付清
  CANCELLED // 已取消/作廢
  
}
// 付款方式
enum PaymentMethod {
  CASH       // 現金
  TRANSFER   // 銀行轉帳
  CHECK      // 支票
  CREDIT_CARD // 信用卡
  LINE_PAY   // 行動支付
  OTHER      // 其他
}
// 付款類型
enum PaymentType {
  DOWN_PAYMENT  // 訂金
  MILESTONE     // 期中款
  FINAL         // 尾款
  FULL          // 全額一次付清
  
}
model Invoice {
  id              String        @id @default(cuid())
  invoiceNo       String        @unique // 收據編號 (例如: INV-2026-0001)
  // 關聯
  quotationId     String?       
  quotation       Quotation?    @relation(fields: [quotationId], references: [id])
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id])
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  // 公司抬頭（開收據的公司）
  companyProfileId String?
  companyProfile   CompanyProfile? @relation(fields: [companyProfileId], references: [id])
  // 金額核心
  totalAmount     Decimal       // 收據總金額
  paidAmount      Decimal       @default(0) // 已付金額
  balanceAmount   Decimal       // 未付金額（尾款）= totalAmount - paidAmount
  // 狀態
  status          InvoiceStatus @default(UNPAID)
  // 日期
  issuedDate      DateTime      @default(now()) // 開立日期
  dueDate         DateTime?                      // 付款到期日
  // 備註
  notes           String?
  // 經手人
  createdById     String
  createdBy       User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  // 關聯付款紀錄
  payments        Payment[]

  type            InvoiceType  @default(STANDARD)
  hasTailInvoice  Boolean      @default(false)
  parentInvoiceId String?      // 關聯到原收據
  parentInvoice   Invoice?     @relation("TailInvoices", fields: [parentInvoiceId], references: [id])
  tailInvoices    Invoice[]    @relation("TailInvoices")

  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@index([issuedDate])
  @@index([createdById])
}
model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // 金額
  amount        Decimal       // 本次付款金額
  // 類型
  type          PaymentType   // 訂金 / 期中款 / 尾款 / 全額
  // 付款方式
  method        PaymentMethod
  // 參考資訊
  reference     String?       // 交易參考編號（轉帳末五碼、支票號碼等）
  // 備註
  note          String?
  // 付款人
  payerName     String?       // 付款人名稱
  // 收款日期
  paidAt        DateTime      @default(now())
  // 經手人
  receivedById  String?
  receivedBy    User?         @relation("PaymentReceiver", fields: [receivedById], references: [id])
  createdAt     DateTime      @default(now())
  @@index([invoiceId])
  @@index([paidAt])
  @@index([type])
}


enum SenderType {
  SALES
  CUSTOMER
}